# Sign in: 201 (409 on later runs, the email already exists)
POST http://localhost:3000/api/auth/signin HTTP/1.1
content-type: application/json

{
    "name": "Test Student",
    "email": "student@example.com",
    "password": "correct-horse-battery",
    "yearOfStudy": "YEAR_2"
}

###

# Sign in with an email that is already registered: 409
POST http://localhost:3000/api/auth/signin HTTP/1.1
content-type: application/json

{
    "name": "Someone Else",
    "email": "Student@Example.com",
    "password": "another-long-password",
    "yearOfStudy": "YEAR_1"
}

###

# Sign in with invalid input: 400 with details
POST http://localhost:3000/api/auth/signin HTTP/1.1
content-type: application/json

{
    "name": "Bad Input",
    "email": "not-an-email",
    "password": "short",
    "yearOfStudy": "YEAR_9"
}

###

# Sign in sending a role: role is ignored, the user is a STUDENT
POST http://localhost:3000/api/auth/signin HTTP/1.1
content-type: application/json

{
    "name": "Sneaky Student",
    "email": "sneaky@example.com",
    "password": "correct-horse-battery",
    "yearOfStudy": "NEW_STUDENT",
    "role": "ADMIN"
}

###

# Login: 200, sets the refreshToken cookie
POST http://localhost:3000/api/auth/login HTTP/1.1
content-type: application/json

{
    "email": "student@example.com",
    "password": "correct-horse-battery"
}

###

# Login with a wrong password: 401
POST http://localhost:3000/api/auth/login HTTP/1.1
content-type: application/json

{
    "email": "student@example.com",
    "password": "wrong-password"
}

###

# Login with an unknown email: same 401 as a wrong password
POST http://localhost:3000/api/auth/login HTTP/1.1
content-type: application/json

{
    "email": "nobody@example.com",
    "password": "correct-horse-battery"
}

###

# Login with a missing password: 400
POST http://localhost:3000/api/auth/login HTTP/1.1
content-type: application/json

{
    "email": "student@example.com"
}

###

# Refresh: 200, sends the cookie from sign in / login and gets a new one
POST http://localhost:3000/api/auth/refresh HTTP/1.1

###

# Refresh with a forged token: 401
POST http://localhost:3000/api/auth/refresh HTTP/1.1
cookie: refreshToken=not-a-real-token

###

# Logout: 204, ends the session and clears the refreshToken cookie
POST http://localhost:3000/api/auth/logout HTTP/1.1

###

# Logout again (no cookie now): still 204
POST http://localhost:3000/api/auth/logout HTTP/1.1

###

# Unknown route: 404
GET http://localhost:3000/api/does-not-exist HTTP/1.1
