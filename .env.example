PORT=3000
# Optional: error | warn | info | http | verbose | debug | silly (default: debug in dev, info in production)
LOG_LEVEL=
OPENROUTER_KEY=

# Neon-managed: filled in by `neon deploy` / `neon env pull` (see neon.ts and .neon)
# Postgres — pooled URL for the app, direct (unpooled) URL for Prisma CLI / migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Object Storage — S3-compatible, branch-scoped credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
